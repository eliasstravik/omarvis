{
  "schemaVersion": 1,
  "id": "io.github.eliasstravik.omarvis",
  "name": "Omarvis",
  "version": "1.0.0",
  "author": "Elias Stravik",
  "license": "MIT",
  "description": "Jarvis for Omarchy",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Omarvis",
    "category": "AI",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "showLabel": false
    },
    "schema": [
      {
        "key": "showLabel",
        "type": "bool",
        "label": "Show state label"
      }
    ]
  }
}
