#!/bin/bash
#
# SUPER+SPACE dispatcher: while a dictation recording is open, Space chords
# into hands-free mode (Wispr Flow style); otherwise it opens the Omarchy
# menu that SUPER+SPACE is bound to by default.
#
# The marker file is maintained by Service.qml on dictation state changes so
# this stays a sub-millisecond file test instead of a ~300ms shell IPC call
# in front of the launcher.

MARKER="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarvis-dictating"

if [ -f "$MARKER" ]; then
  exec omarchy-shell omarvis dictate handsfree
fi

exec omarchy-menu toggle
