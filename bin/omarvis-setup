#!/bin/bash

set -euo pipefail

PLUGIN_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
CONFIG_DIR="$HOME/.config/omarchy/omarvis"
CONFIG_PATH="$CONFIG_DIR/config.json"
KEY_PATH="$CONFIG_DIR/api_key"
PROFILE_PATH="$CONFIG_DIR/profile.md"
VENV_DIR="$HOME/.local/share/omarvis/venv"
BINDINGS_PATH="$HOME/.config/hypr/bindings.lua"
AGENT_BINDING='o.bind("SUPER + CTRL + J", "Omarvis", "omarchy-shell omarvis toggle")'
ASK_LEGACY_BINDING='o.bind("SUPER + SHIFT + J", "Omarvis Ask", "omarchy-shell omarvis toggle ask")'
ASK_BINDING='o.bind("SUPER + SHIFT + J", "Omarvis Ask", "omarchy-shell omarvis toggleMode ask")'
DICTATE_UNBIND='hl.unbind("SUPER + J")'
DICTATE_START_BINDING='o.bind("SUPER + J", "Omarvis Dictate", "omarchy-shell omarvis dictate start")'
DICTATE_STOP_BINDING='o.bind("SUPER + J", "Omarvis Dictate Stop", "omarchy-shell omarvis dictate stop", { release = true })'
TEXT_BINDING='o.bind("SUPER + ALT + J", "Omarvis Text", "'"$PLUGIN_DIR"'/bin/omarvis-text")'

need_command() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "Missing required command: $1" >&2
    exit 1
  }
}

need_command omarchy
need_command python
need_command jq

echo "Installing audio dependencies..."
omarchy pkg add portaudio python-pyaudio

if ! command -v wtype >/dev/null 2>&1; then
  read -r -p "Dictation needs wtype. Install it now? [Y/n] " answer
  if [[ -z $answer || $answer == [yY] || $answer == [yY][eE][sS] ]]; then
    omarchy pkg add wtype
  else
    echo "Dictation will remain unavailable until wtype is installed." >&2
  fi
fi

if ! command -v agent-browser >/dev/null 2>&1; then
  if command -v npm >/dev/null 2>&1; then
    echo "Installing agent-browser 0.34..."
    npm install -g agent-browser@0.34
  else
    echo "npm is unavailable. Browser control will remain disabled." >&2
  fi
fi

AGENT_BROWSER_PATH=$(command -v agent-browser || true)
BROWSER_MODE="unavailable"
BROWSER_EXECUTABLE=""

for browser in chromium google-chrome google-chrome-stable chrome; do
  if command -v "$browser" >/dev/null 2>&1; then
    BROWSER_EXECUTABLE=$(command -v "$browser")
    break
  fi
done

if [[ -n $AGENT_BROWSER_PATH ]]; then
  if [[ -n $BROWSER_EXECUTABLE ]] && [[ -d $HOME/.config/chromium/Default || -d $HOME/.config/google-chrome/Default ]]; then
    BROWSER_MODE="real-profile"
  else
    BROWSER_MODE="omarvis-browser"
    if [[ -z $BROWSER_EXECUTABLE ]]; then
      echo "No Chromium executable found. Installing agent-browser's managed browser..."
      agent-browser install
    fi
  fi
fi

echo
if [[ $BROWSER_MODE == "real-profile" ]]; then
  echo "Omarvis will drive the browser in a separate window using a snapshot of your Default profile."
  echo "Your logins are available there; changes in that window are not written back to your real profile."
elif [[ $BROWSER_MODE == "omarvis-browser" ]]; then
  echo "Omarvis will use its own browser profile under ~/.local/share/omarvis/browser-profile (separate logins)."
fi

echo "Creating the Omarvis Python environment..."
python -m venv --system-site-packages "$VENV_DIR"
"$VENV_DIR/bin/pip" install "elevenlabs>=2,<3"

install -d -m 700 "$CONFIG_DIR"
if [[ ! -s $KEY_PATH && -z ${ELEVENLABS_API_KEY:-} ]]; then
  read -r -s -p "ElevenLabs API key: " api_key
  echo
  install -m 600 /dev/null "$KEY_PATH"
  printf '%s\n' "$api_key" >"$KEY_PATH"
  unset api_key
fi

existing='{}'
if [[ -f $CONFIG_PATH ]]; then
  existing=$(cat "$CONFIG_PATH")
fi
updated=$(jq \
  --arg browser_mode "$BROWSER_MODE" \
  --arg agent_browser_path "$AGENT_BROWSER_PATH" \
  --arg browser_executable_path "$BROWSER_EXECUTABLE" \
  '. + {
    agent_id: (.agent_id // ""),
    ask_agent_id: (.ask_agent_id // ""),
    llm: (.llm // "gpt-5.6-sol"),
    input_device_index: (.input_device_index // null),
    herdr_announcements: (.herdr_announcements // true),
    browser_mode: $browser_mode,
    agent_browser_path: $agent_browser_path,
    profile_path: (.profile_path // "~/.config/omarchy/omarvis/profile.md"),
    screenshot_cache_max_age_seconds: (.screenshot_cache_max_age_seconds // 86400),
    browser_executable_path: $browser_executable_path,
    dictation: ((.dictation // {}) + {
      language: (.dictation.language // ""),
      cleanup: (.dictation.cleanup // true),
      model_id: (.dictation.model_id // "scribe_v2"),
      chunk_size: (.dictation.chunk_size // 500)
    }),
    vision: ((.vision // {}) + {
      enabled: (.vision.enabled // false),
      provider: (.vision.provider // "anthropic"),
      model: (.vision.model // ""),
      api_key_path: (.vision.api_key_path // "~/.config/omarchy/omarvis/vision_api_key"),
      endpoint: (.vision.endpoint // "https://api.anthropic.com/v1/messages"),
      max_tokens: (.vision.max_tokens // 500)
    })
  }' <<<"$existing")
install -m 600 /dev/null "$CONFIG_PATH"
printf '%s\n' "$updated" >"$CONFIG_PATH"

if [[ ! -e $PROFILE_PATH ]]; then
  install -m 600 /dev/null "$PROFILE_PATH"
  printf '%s\n' \
    '# Omarvis profile' \
    '' \
    '- Preferred name: ' \
    '- Work and projects: ' \
    '- Omarchy preferences: ' >"$PROFILE_PATH"
fi
echo "Personalize Omarvis memory in $PROFILE_PATH (up to 2000 characters are used)."

cd "$PLUGIN_DIR"
"$VENV_DIR/bin/python" -m omarvis.provision

echo
echo "Hotkey bindings:"
echo "$AGENT_BINDING"
echo "$ASK_BINDING"
echo "$DICTATE_UNBIND  -- replaces Omarchy's Toggle window split binding"
echo "$DICTATE_START_BINDING"
echo "$DICTATE_STOP_BINDING"
echo "$TEXT_BINDING"
missing_bindings=()
needs_dictation_rebind=false
needs_ask_rebind=false
if [[ -f $BINDINGS_PATH ]]; then
  grep -Fq 'omarchy-shell omarvis toggle")' "$BINDINGS_PATH" || missing_bindings+=("$AGENT_BINDING")
  grep -Fq 'omarchy-shell omarvis toggleMode ask")' "$BINDINGS_PATH" || missing_bindings+=("$ASK_BINDING")
  if grep -Fq "$ASK_LEGACY_BINDING" "$BINDINGS_PATH"; then
    needs_ask_rebind=true
  fi
  if ! grep -Fq "$DICTATE_UNBIND" "$BINDINGS_PATH"; then
    needs_dictation_rebind=true
    missing_bindings+=("$DICTATE_UNBIND" "$DICTATE_START_BINDING" "$DICTATE_STOP_BINDING")
  else
    grep -Fq 'omarchy-shell omarvis dictate start")' "$BINDINGS_PATH" || missing_bindings+=("$DICTATE_START_BINDING")
    grep -Fq 'omarchy-shell omarvis dictate stop", { release = true })' "$BINDINGS_PATH" || missing_bindings+=("$DICTATE_STOP_BINDING")
  fi
  grep -Fq '/bin/omarvis-text")' "$BINDINGS_PATH" || missing_bindings+=("$TEXT_BINDING")
fi
if (( ${#missing_bindings[@]} > 0 )) || [[ $needs_ask_rebind == true ]]; then
  read -r -p "Update the missing or outdated bindings in $BINDINGS_PATH? [y/N] " answer
  if [[ $answer == [yY] || $answer == [yY][eE][sS] ]]; then
    backup="$BINDINGS_PATH.$(date +%Y%m%d-%H%M%S).bak"
    cp "$BINDINGS_PATH" "$backup"
    if [[ $needs_dictation_rebind == true ]]; then
      sed -i \
        -e '\|omarchy-shell omarvis dictate start")|d' \
        -e '\|omarchy-shell omarvis dictate stop", { release = true })|d' \
        "$BINDINGS_PATH"
    fi
    if [[ $needs_ask_rebind == true ]]; then
      sed -i "\|$ASK_LEGACY_BINDING|d" "$BINDINGS_PATH"
    fi
    if (( ${#missing_bindings[@]} > 0 )); then
      printf '\n' >>"$BINDINGS_PATH"
      printf '%s\n' "${missing_bindings[@]}" >>"$BINDINGS_PATH"
    fi
    echo "Updated bindings. Backup: $backup"
  fi
fi

omarchy-shell shell rescanPlugins
omarchy plugin enable omarvis.voice

echo
echo "Plugin self-check:"
omarchy-shell shell listPlugins | jq '.[] | select(.id == "omarvis.voice")'
omarchy-shell omarvis status

echo
echo "Omarvis setup complete. Press SUPER + CTRL + J or click the microphone in the bar."
