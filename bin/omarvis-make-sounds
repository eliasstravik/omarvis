#!/usr/bin/env python3
"""Generate Omarvis earcons from simple synthesized waveforms."""

from __future__ import annotations

import math
import struct
import wave
from pathlib import Path


RATE = 48_000
PEAK = 32767 * (10 ** (-12 / 20))
OUTPUT_DIR = Path(__file__).resolve().parent.parent / "assets" / "sounds"


def envelope(index: int, frames: int) -> float:
    fade = int(RATE * 0.012)
    return min(1.0, index / fade, (frames - 1 - index) / fade)


def chirp(start_hz: float, end_hz: float, duration: float = 0.12) -> list[int]:
    frames = int(RATE * duration)
    phase = 0.0
    samples = []
    for index in range(frames):
        frequency = start_hz + (end_hz - start_hz) * index / max(1, frames - 1)
        phase += 2 * math.pi * frequency / RATE
        samples.append(round(PEAK * envelope(index, frames) * math.sin(phase)))
    return samples


def buzz(duration: float = 0.15) -> list[int]:
    frames = int(RATE * duration)
    return [
        round(
            PEAK
            * envelope(index, frames)
            * (0.72 * math.sin(2 * math.pi * 180 * index / RATE)
               + 0.28 * math.sin(2 * math.pi * 235 * index / RATE))
        )
        for index in range(frames)
    ]


def write_sound(path: Path, samples: list[int]) -> None:
    with wave.open(str(path), "wb") as output:
        output.setnchannels(1)
        output.setsampwidth(2)
        output.setframerate(RATE)
        output.writeframes(b"".join(struct.pack("<h", sample) for sample in samples))


def main() -> None:
    OUTPUT_DIR.mkdir(parents=True, exist_ok=True)
    write_sound(OUTPUT_DIR / "mic-open.wav", chirp(620, 1040))
    write_sound(OUTPUT_DIR / "mic-close.wav", chirp(1040, 620))
    write_sound(OUTPUT_DIR / "error.wav", buzz())


if __name__ == "__main__":
    main()
